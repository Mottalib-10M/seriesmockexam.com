---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/sie-practice/" title="SIE practice quiz" width="100%" height="820" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/finra-license-finder/" title="Which FINRA exams does my job need" width="100%" height="560" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free SIE practice quiz on your website" description="Put the free SIE practice quiz or the FINRA license finder on a university, club or career site: one iframe, no sign-up, no tracking, no cost, updated with each rule." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a quiz or the license finder</h1>
    <p class="mt-3 text-lg text-navy-700">For universities, student investment clubs and career services that help students into finance.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>SIE practice quiz</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Which exams does a job need</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When a fee or a format changes, the embedded tool updates itself. Nothing your visitors answer reaches us and the frame sets no cookie. Each frame states that the site is independent of FINRA and NASAA. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/sie-practice/" title="SIE practice quiz" width="100%" height="820" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
